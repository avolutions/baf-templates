{
  "$schema": "http://json.schemastore.org/template",
  "author": "Alexander Vogt",
  "classifications": [
    "Business Application Framework",
    "BAF",
    "App"
  ],
  "defaultName": "AvolutionsBafApp",
  "description": "Creates a minimal .NET app scaffold for BAF.",
  "groupIdentity": "Avolutions.Baf.App",
  "identity": "Avolutions.Baf.App.CSharp",
  "name": "Avolutions BAF App",
  "preferNameDirectory": true,
  "primaryOutputs": [
    { "path": "BafApp.csproj" }
  ],
  "shortName": "baf",
  "sourceName": "BafApp",
  "tags": {
    "language": "C#",
    "type": "project" },

  "postActions": [
    {
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "args": { "executable": "dotnet", "args": "restore" },
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ]
    }
  ]
}
