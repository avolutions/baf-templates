{
  "$schema": "http://json.schemastore.org/template",
  "author": "Alexander Vogt",
  "classifications": [
    "Business Application Framework",
    "BAF",
    "App",
    "Web",
    "Blazor"
  ],
  "defaultName": "BafApp",
  "description": "Creates a minimal Blazor app scaffold for BAF.",
  "groupIdentity": "Avolutions.Baf",
  "identity": "Avolutions.Baf.Templates.baf-blazor",
  "name": "Avolutions BAF Blazor App",
  "preferNameDirectory": true,
  "primaryOutputs": [
    { "path": "Baf.BlazorApp.csproj" }
  ],
  "shortName": "baf-blazor",
  "sourceName": "Baf.BlazorApp",
  "tags": {
    "language": "C#",
    "type": "project"
  },

  "postActions": [
    {
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "args": { "executable": "dotnet", "args": "restore" },
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ]
    }
  ]
}
